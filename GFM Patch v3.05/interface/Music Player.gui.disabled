		# Music volume slider - a copy of musicvolume_slider from the settings window (wired by PLAYER_BUTTONS in v2dll_settings.ini)
		scrollbarType = {
			name = "fe_player_volume_slider"
			slider = "fe_player_volume_SliderButton"
			track = "fe_player_volume_TrackButton"
			leftbutton = "fe_player_volume_upButton"
			rightbutton = "fe_player_volume_downButton"
			size = { x = 160 y = 20 }
			position = { x = 201 y = 127 }
			priority = 100
			borderSize = { x = 16 y = 16 }
			maxValue = 100
			minValue = 0
			stepSize = 1
			startValue = 20
			horizontal = 1

			guiButtonType = {
				name = "fe_player_volume_SliderButton"
				quadTextureSprite = "GFX_slider_circle_player"
				tooltip = ""
				tooltipText = ""
				delayedTooltipText = ""
